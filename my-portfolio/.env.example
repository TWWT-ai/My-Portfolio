# Copy to .env.local for development, and set the same keys in
# Vercel -> Settings -> Environment Variables for production.

# --- Database (already in use) ---
# Use a POOLED connection string on Vercel. A Supabase direct connection
# (db.<ref>.supabase.co:5432) is IPv6-only and times out from Vercel's builders.
DATABASE_URL=

# --- Resend, for the "Get my resume" form ---
# Server-only. Never prefix with NEXT_PUBLIC_ or it ships to the browser.
RESEND_API_KEY=

# Must be an address at a domain verified in Resend.
# Unset falls back to "onboarding@resend.dev", which ONLY delivers to the
# email address that owns the Resend account — fine for development.
RESUME_FROM="Temuulen Wang <hello@yourdomain.com>"

# Where resume-request notifications are sent. Defaults to temuulenwang@gmail.com.
RESUME_TO=

# Public URL of the resume PDF. Defaults to /resume.pdf on the current deployment,
# which requires public/resume.pdf to exist.
RESUME_URL=
